+@layer base {
+  body {
+    margin: 0;
+    padding: 0;
+    min-height: 100vh;
+    background-color: #f1f5f9;
+    background-image: 
+      radial-gradient(at 5% 5%, rgba(191, 219, 254, 0.75) 0px, transparent 48%),
+      radial-gradient(at 95% 5%, rgba(224, 231, 255, 0.7) 0px, transparent 45%),
+      radial-gradient(at 50% 45%, rgba(241, 245, 249, 0.6) 0px, transparent 65%),
+      radial-gradient(at 95% 95%, rgba(199, 210, 254, 0.65) 0px, transparent 50%),
+      radial-gradient(at 5% 95%, rgba(224, 242, 254, 0.75) 0px, transparent 50%),
+      radial-gradient(at 50% 100%, rgba(243, 232, 255, 0.4) 0px, transparent 60%);
+    background-attachment: fixed;
+    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+    color: #0f172a;
+    -webkit-font-smoothing: antialiased;
+  }
+
+  * {
+    box-sizing: border-box;
+  }
+
+  #root {
+    min-height: 100vh;
+  }
+}
+
+/* Enhanced Glassmorphism Design System */
+.glass-panel {
+  background: rgba(255, 255, 255, 0.62);
+  backdrop-filter: blur(28px) saturate(190%);
+  -webkit-backdrop-filter: blur(28px) saturate(190%);
+  border: 1px solid rgba(255, 255, 255, 0.9);
+  box-shadow: 
+    0 12px 36px 0 rgba(15, 33, 55, 0.05),
+    0 1px 3px 0 rgba(15, 33, 55, 0.03),
+    inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.95);
+}
+
+.glass-sidebar {
+  background: rgba(255, 255, 255, 0.68);
+  backdrop-filter: blur(32px) saturate(200%);
+  -webkit-backdrop-filter: blur(32px) saturate(200%);
+  border-right: 1px solid rgba(255, 255, 255, 0.85);
+  box-shadow: 
+    6px 0 32px 0 rgba(15, 33, 55, 0.035),
+    inset -1px 0 1px 0 rgba(255, 255, 255, 0.8);
+}
+
+.glass-header {
+  background: rgba(255, 255, 255, 0.70);
+  backdrop-filter: blur(28px) saturate(190%);
+  -webkit-backdrop-filter: blur(28px) saturate(190%);
+  border-bottom: 1px solid rgba(255, 255, 255, 0.85);
+  box-shadow: 
+    0 4px 20px 0 rgba(15, 33, 55, 0.025),
+    inset 0 -1px 1px 0 rgba(255, 255, 255, 0.8);
+}
+
+.glass-card-hover {
+  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+  position: relative;
+}
+
+.glass-card-hover:hover {
+  transform: translateY(-3px);
+  background: rgba(255, 255, 255, 0.82);
+  border-color: rgba(255, 255, 255, 1);
+  box-shadow: 
+    0 22px 45px -10px rgba(15, 33, 55, 0.09),
+    0 0 0 1px rgba(15, 33, 55, 0.15),
+    inset 0 1px 2px 0 rgba(255, 255, 255, 1);
+}
+
+.glass-pill-active {
+  background: linear-gradient(135deg, rgba(15, 33, 55, 0.14) 0%, rgba(30, 58, 102, 0.07) 100%);
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+  border-left: 4px solid #0f2137;
+  color: #0f2137;
+  font-weight: 800;
+  box-shadow: 
+    0 6px 16px rgba(15, 33, 55, 0.07),
+    inset 0 1px 1px 0 rgba(255, 255, 255, 0.9);
+}
+
+.glass-pill-idle {
+  color: #475569;
+  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.glass-pill-idle:hover {
+  background: rgba(255, 255, 255, 0.7);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+  color: #0f2137;
+  box-shadow: 0 4px 12px rgba(15, 33, 55, 0.03);
+}
+
+/* Glass table styling */
+.glass-table-container {
+  background: rgba(255, 255, 255, 0.6);
+  backdrop-filter: blur(20px);
+  -webkit-backdrop-filter: blur(20px);
+  border: 1px solid rgba(255, 255, 255, 0.85);
+  box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.8);
+}
+
+/* Custom glassy modern scrollbar */
+::-webkit-scrollbar {
+  width: 6px;
+  height: 6px;
+}
+
+::-webkit-scrollbar-track {
+  background: transparent;
+}
+
+::-webkit-scrollbar-thumb {
+  background: rgba(148, 163, 184, 0.5);
+  backdrop-filter: blur(8px);
+  border-radius: 9999px;
+}
+
+::-webkit-scrollbar-thumb:hover {
+  background: rgba(100, 116, 139, 0.75);
+}
