+def _clean_extracted_sku(raw_value: str):
+
+    value = str(raw_value or "").strip()
+
+    value = re.sub(r"\s+", " ", value)
+
+    value = re.split(
+
+        r"\s{2,}|\b(?:qty|quantity|hsn|asin|fnsku|tax|description)\b",
+
+        value,
+
+        flags=re.IGNORECASE,
+
+    )[0].strip(" :-#|")
+
+    value = re.sub(r"\s+", "", value)
+
+    return value[:80]
+
+
+
+
