+def add_icons(m):
+    icons = m.group(1).replace('\n', '').split(',')
+    icons = [i.strip() for i in icons if i.strip()]
+    for new_icon in ['BarChart3', 'TrendingUp', 'TrendingDown', 'Activity']:
+        if new_icon not in icons:
