+    return enriched_df[
+        ["sku", "quantity", "order_id", "price"]
+    ].fillna("").to_dict(
+        orient="records"
+    )
+
+def filter_myntra_orders(file_path):
+
+    if file_path.endswith(".csv"):
+
+        df = pd.read_csv(file_path)
+
+    else:
+
+        df = pd.read_excel(
+            file_path,
+            engine="openpyxl"
+        )
+
+    df.columns = [
+        normalize_column_name(col)
+        for col in df.columns
+    ]
+
+    orders = []
+
+    for _, row in df.iterrows():
+
+        sku = str(
+            row.get("seller_sku_code", "")
+        ).strip()
+
+        qty = 1
+
+        if sku and qty > 0:
+
+            orders.append({
+                "sku": sku,
+                "quantity": qty,
+                "order_id": str(
+                    row.get("orderid", "")
+                ).strip(),
+                "price": parse_money(
+                    row.get("sellingvalue", 0)
+                )
