+def _extract_pack_of(sku: str):
+
+    match = re.search(
+
+        r"(?<![A-Z0-9])(\d+)\s*(?:P|PC|PCS)(?![A-Z0-9])",
+
+        str(sku or ""),
+
+        flags=re.IGNORECASE,
+
+    )
+
+
+
+    if match:
+
+        return f"{match.group(1)}p"
+
+
+
+    return "1p"
+
+
