+                      selectedValues={selectedStyles}
+                      onFilterChange={setSelectedStyles}
+                      sortField={sortField}
+                      sortAsc={sortAsc}
+                      onSort={handleSort}
+                      align="left"
+                    />
+                  </th>
+
+                  <th className="px-4 py-3 min-w-[180px]">
+                    <ExcelHeaderFilter
+                      label="Color"
+                      columnKey="color"
+                      values={uniqueColors}
