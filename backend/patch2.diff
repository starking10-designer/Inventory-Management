+    std::unique_ptr<X509CertificateInfo> cert_info;
+    std::string signer_name;
+    std::string subject_dn;
+    GooString location;
+    GooString reason;
+    HashAlgorithm hash_type = HashAlgorithm::Unknown;
+    time_t signing_time = 0;
+    bool sig_subfilter_supported = false;
+};
