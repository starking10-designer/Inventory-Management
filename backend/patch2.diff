+            .all()
+
+        )
+
+
+
+        summary_rows, size_columns = _pivot_daily_report_rows(rows)
+
+
+
+        wb = Workbook()
+
+        ws = wb.active
+
+        ws.title = "Warehouse Report"
+
+
+
+        header_fill = PatternFill(
+
+            "solid",
+
+            fgColor="0E7490",
