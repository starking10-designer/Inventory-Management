+
+    const std::vector<TextWord *> &getWords() const { return words; }
+
+private:
+    std::vector<TextWord *> words;
+};
+
+class TextWordSelection
+{
+public:
+    TextWordSelection(const TextWord *wordA, int beginA, int endA) : word(wordA), begin(beginA), end(endA) { }
