+class POPPLER_PRIVATE_EXPORT Attribute
+{
+public:
+    enum Type
+    {
+        Unknown = 0, // Uninitialized, parsing error, etc.
+        UserProperty, // User defined attribute (i.e. non-standard)
+
+        // Common standard attributes
+        Placement,
+        WritingMode,
+        BackgroundColor,
+        BorderColor,
+        BorderStyle,
+        BorderThickness,
+        Color,
+        Padding,
