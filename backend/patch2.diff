+def _extract_ajio_invoice_consignment_no(text: str):
+
+    match = re.search(r"Consignment\s+No\s*:\s*([A-Z0-9]+)", str(text or ""), flags=re.IGNORECASE)
+
+    return match.group(1).strip() if match else ""
