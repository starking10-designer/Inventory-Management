+            media_type=(
+
+                "application/vnd.openxmlformats-officedocument"
+
+                ".spreadsheetml.sheet"
+
+            ),
+
+            headers={
+
+                "Content-Disposition": (
+
+                    f'attachment; filename="{filename}"'
+
+                )
+
+            },
+
+        )
+
+    finally:
+
+        db.close()
