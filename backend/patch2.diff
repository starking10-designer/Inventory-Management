+    void getParameterizedColor(double t, GfxColor *color) const;
+
+protected:
+    bool init(GfxResources *res, Dict *dict, OutputDev *out, GfxState *state) override;
+
+private:
+    GfxPatch *patches;
+    int nPatches;
+    std::vector<std::unique_ptr<Function>> funcs;
