--- /dev/null
+++ b/poppler-26.02.0/Library/include/poppler/XRef.h
@@ -0,0 +1,336 @@
+//========================================================================
+//
+// XRef.h
+//
+// Copyright 1996-2003 Glyph & Cog, LLC
+//
