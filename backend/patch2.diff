+@router.get(
+
+    "/current-sku-master"
+
+)
+
+def current_sku_master():
+
+
+
+    upload_folder = UPLOAD_FOLDER
+
+
+
+    if not os.path.exists(
+
+        upload_folder
+
+    ):
+
+
+
+        return {
+
+            "filename": None
+
+        }
+
+
+
+    files = os.listdir(
+
+        upload_folder
+
+    )
+
+
+
+    sku_files = [
+
+
+
+        file for file in files
+
+
+
+        if (
+
+            "sku" in file.lower()
+
+            or
+
+            "master" in file.lower()
+
+        )
+
+    ]
+
+
+
+    if not sku_files:
+
+
+
+        return {
+
+            "filename": None
+
+        }
+
+
+
+    latest_file = max(
+
+
+
+        sku_files,
+
+
+
+        key=lambda f: os.path.getctime(
+
+            os.path.join(
+
+                upload_folder,
+
+                f
+
