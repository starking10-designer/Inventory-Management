+def _filter_snapshot_rows(rows, search, fields):
+    search_text = str(search or "").strip().lower()
+    if not search_text:
+        return rows
+
+    filtered = []
+    for row in rows or []:
+        haystack = " ".join(
+            str(row.get(field, "") or "").lower()
+            for field in fields
+        )
+        if search_text in haystack:
+            filtered.append(row)
+    return filtered
