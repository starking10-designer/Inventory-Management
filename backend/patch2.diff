+def _parse_report_date(report_date: str):
+
+    for date_format in ("%Y-%m-%d", "%d-%m-%Y"):
+
+        try:
+
+            return datetime.strptime(
+
+                report_date,
+
+                date_format
+
+            ).date()
+
+        except ValueError:
+
+            continue
+
+
+
+    raise HTTPException(
+
+        status_code=400,
+
+        detail="Invalid date format. Use YYYY-MM-DD or DD-MM-YYYY."
+
+    )
+
+
