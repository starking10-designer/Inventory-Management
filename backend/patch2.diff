+        entry = combo_pack.setdefault(
+
+            key,
+
+            {
+
+                "pack_of": row.pack_of or "1p",
+
+                "style": detail_style,
+
+                "color": row.color or "Unknown",
+
+                "total": 0,
+
+                "sizes": {},
+
+            },
